# Puertos y entorno
PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS (coma-separados). Vacío = permitir todos
# Ejemplo: http://localhost:8081,http://localhost:19006
CORS_ORIGINS=

# Opción A: Credencial completa (JSON) en una variable.
# - Puedes pegar el JSON completo (reemplaza saltos de línea por \n)
# - O usar un prefijo base64: seguido del JSON en base64 (ej: base64:eyJ0eXBlIjo...)
# Ejemplo:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",...}
FIREBASE_SERVICE_ACCOUNT_KEY=

# Opción B: Campos separados (útil en algunos hosting)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave privada con saltos de línea escapados (\n). Ej:
# -----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# Nota: si usas FIREBASE_SERVICE_ACCOUNT_KEY puedes omitir los campos separados.
